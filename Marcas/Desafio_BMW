<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Fotos BMW</title>
    
    <style>
        /* --- Tus estilos originales de diseño --- */
        img {
            display: block;
            width: 300px;
            height: 210px;
            object-fit: contain;
        }

        table {
            margin: 24px auto;
        }

        td {
            text-align: center;
        }

        .tabla-vertical img {
            width: min(560px, 75vw);
            height: 320px;
        }

        .tabla-mixta img {
            width: min(360px, 40vw);
            height: 220px;
        }

        .video {
            width: min(640px, 75vw);
            aspect-ratio: 16 / 9;
            margin: 0 auto;
        }

        .video iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        @media (max-width: 600px) {
            img {
                width: 40vw;
                height: 150px;
            }

            .tabla-vertical img {
                height: auto;
            }

            .tabla-mixta img {
                height: 150px;
            }
        }

        /* --- Centrado de todos los títulos del documento --- */
        h1, h2, p {
            text-align: center;
        }

        /* --- Lógica avanzada de pantallas (Efecto "Solo una sección") --- */
        
        /* 1. Por defecto, el índice está visible y las galerías ocultas */
        #inicio {
            display: block;
        }
        #suv, #berlinas, #deportivos {
            display: none;
        }

        /* 2. Cuando se selecciona una categoría, ocultamos el índice principal automáticamente */
        html:has(#suv:target) #inicio,
        html:has(#berlinas:target) #inicio,
        html:has(#deportivos:target) #inicio {
            display: none;
        }

        /* 3. Mostramos únicamente la sección activa en la pantalla */
        #suv:target, #berlinas:target, #deportivos:target {
            display: block;
        }
    </style>
</head>
<body>

    <!-- ÍNDICE PRINCIPAL (Se ocultará solo al entrar en una categoría) -->
    <header id="inicio">
        <h1>Fotos BMW</h1>

        <table border="1" cellpadding="12" cellspacing="0">
            <tr>
                <th>Tipos de Coches BMW</th>
            </tr>
            <tr>
                <td><a href="#suv">SUV</a></td>
            </tr>
            <tr>
                <td><a href="#berlinas">Berlinas</a></td>
            </tr>
            <tr>
                <td><a href="#deportivos">Deportivos y vídeo</a></td>
            </tr>
        </table>
    </header>

    <!-- GALERÍA SUV -->
    <section id="suv">
        <h2>BMW SUV</h2>
        <p><a href="#inicio">Volver al índice</a></p>

        <table border="1" cellpadding="10" cellspacing="0">
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/2025_BMW_XM.jpg?width=900" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/2025_BMW_XM.jpg?width=900" alt="BMW XM" title="BMW XM">
                    </a>
                </td>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_X6_xDrive40d_M_Sport_%28G06%2C_Facelift%29_%E2%80%93_f_12042026.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_X6_xDrive40d_M_Sport_%28G06%2C_Facelift%29_%E2%80%93_f_12042026.jpg" alt="BMW X6" title="BMW X6">
                    </a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/Bmwx5.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Bmwx5.jpg" alt="BMW X5" title="BMW X5">
                    </a>
                </td>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW--X3.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW--X3.jpg" alt="BMW X3" title="BMW X3">
                    </a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_X7.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_X7.jpg" alt="BMW X7" title="BMW X7">
                    </a>
                </td>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/2019_BMW_X1_--_avant.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/2019_BMW_X1_--_avant.jpg" alt="BMW X1" title="BMW X1">
                    </a>
                </td>
            </tr>
        </table>
    </section>

    <!-- GALERÍA BERLINAS -->
    <section id="berlinas">
        <h2>BMW Berlinas</h2>
        <p><a href="#inicio">Volver al índice</a></p>

        <table class="tabla-vertical" border="1" cellpadding="10" cellspacing="0">
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M5_CS.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M5_CS.jpg" alt="BMW M5 CS" title="BMW M5 CS">
                    </a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M3_Sedan.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M3_Sedan.jpg" alt="BMW M3 Sedan" title="BMW M3 Sedan">
                    </a>
                </td>
            </tr>
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/2016_BMW_7-Series_%28G11%29_sedan%2C_front_view.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/2016_BMW_7-Series_%28G11%29_sedan%2C_front_view.jpg alt="BMW Serie 7" title="BMW Serie 7">
                    </a>
                </td>
            </tr>
        </table>
    </section>

    <!-- GALERÍA DEPORTIVOS -->
    <section id="deportivos">
        <h2>BMW Deportivos</h2>
        <p><a href="#inicio">Volver al índice</a></p>

        <table class="tabla-mixta" border="1" cellpadding="10" cellspacing="0">
            <tr>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M8_Competition_IMG_5708.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_M8_Competition_IMG_5708.jpg" alt="BMW M8 Competition" title="BMW M8 Competition">
                    </a>
                </td>
                <td>
                    <a href="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_Z4_M40i.jpg" target="_blank">
                        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/BMW_Z4_M40i.jpg" alt="BMW Z4 M40i" title="BMW Z4 M40i">
                    </a>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p>Vídeo BMW M8</p>
                    <div class="video">
                        <iframe
                            src="https://www.youtube-nocookie.com/embed/SL_E2q3RSLE"
                            title="Vídeo BMW M8"
                            allowfullscreen>
                        </iframe>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p>Sonido del Motor</p>
                    <audio controls src="sonido_bmw.mp3">
                        El navegador no soporta el elemento de audio.
                    </audio>
                </td>
            </tr>
        </table>
    </section>

</body>
</html>
